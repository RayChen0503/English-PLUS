rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function accountIsActive(uid) {
      let profile = get(userPath(uid)).data;
      return (
          ("accountStatus" in profile && profile.accountStatus == "active")
          || (!("accountStatus" in profile) && profile.active == true)
        );
    }

    function emailAccessAllowed(uid) {
      let profile = get(userPath(uid)).data;
      return (
          "email_verified" in request.auth.token
          && request.auth.token.email_verified == true
        )
        || !("emailVerificationRequired" in profile)
        || profile.emailVerificationRequired != true;
    }

    function hasAccountAccess(uid) {
      return signedIn()
        && request.auth.uid == uid
        && exists(userPath(uid))
        && accountIsActive(uid)
        && emailAccessAllowed(uid);
    }

    function validInitialEmailPolicy(profile) {
      return profile.emailVerificationRequired == true
        || (
          "email_verified" in request.auth.token
          && request.auth.token.email_verified == true
        );
    }

    function validSelfServiceProfile(profile) {
      return (
          profile.primaryRole == "student"
          && profile.active == true
          && profile.accountStatus == "active"
          && profile.provisioningSource == "selfServiceStudent"
        )
        || (
          profile.primaryRole == "teacher"
          && profile.active == true
          && profile.accountStatus == "active"
          && profile.provisioningSource == "selfServiceTeacher"
        )
        || (
          profile.primaryRole == "volunteer"
          && profile.active == false
          && profile.accountStatus in ["pendingApplication", "pendingApproval"]
          && profile.provisioningSource == "selfServiceVolunteer"
        );
    }

    function isTeacherProfileAfter(uid) {
      let profile = getAfter(userPath(uid)).data;
      return profile.primaryRole == "teacher"
        && profile.accountStatus == "active"
        && profile.provisioningSource == "selfServiceTeacher";
    }

    function isPendingVolunteerAfter(uid) {
      let profile = getAfter(userPath(uid)).data;
      return profile.primaryRole == "volunteer"
        && profile.accountStatus in ["pendingApplication", "pendingApproval"]
        && profile.provisioningSource == "selfServiceVolunteer";
    }

    function volunteerApplicationPath(uid) {
      return /databases/$(database)/documents/volunteerApplications/$(uid);
    }

    function validVolunteerSubmission(uid) {
      let currentProfile = resource.data;
      let nextProfile = request.resource.data;
      let application = getAfter(volunteerApplicationPath(uid)).data;
      return currentProfile.primaryRole == "volunteer"
        && currentProfile.accountStatus == "pendingApplication"
        && nextProfile.primaryRole == "volunteer"
        && nextProfile.accountStatus == "pendingApproval"
        && nextProfile.active == false
        && nextProfile.provisioningSource == currentProfile.provisioningSource
        && nextProfile.diff(currentProfile).affectedKeys().hasOnly([
          "accountStatus",
          "active",
          "updatedAt"
        ])
        && application.status == "pendingReview"
        && application.evidence is list
        && application.evidence.size() > 0;
    }

    function validIdentityProviderUpdate(uid) {
      return isSelf(uid)
        && resource.data.accountStatus in ["active", "pendingApplication"]
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.primaryRole == resource.data.primaryRole
        && request.resource.data.identityProviders is list
        && request.resource.data.identityProviders.size() <= 3
        && request.resource.data.identityProviders.hasOnly([
          "emailPassword",
          "google",
          "apple"
        ])
        && request.resource.data.identityProviders.hasAll(
          resource.data.identityProviders
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "identityProviders",
          "updatedAt"
        ]);
    }

    function memberPath(classId, uid) {
      return /databases/$(database)/documents/classes/$(classId)/members/$(uid);
    }

    function classPath(classId) {
      return /databases/$(database)/documents/classes/$(classId);
    }

    function classIsOperational(classId) {
      let classroom = get(classPath(classId)).data;
      return classroom.active == true
        && (
          !("deletionPending" in classroom)
          || classroom.deletionPending != true
        )
        && (
          !("lifecycleStatus" in classroom)
          || classroom.lifecycleStatus == "active"
        );
    }

    function isClassMember(classId) {
      return hasAccountAccess(request.auth.uid)
        && classIsOperational(classId)
        && exists(memberPath(classId, request.auth.uid))
        && membershipIsActive(get(memberPath(classId, request.auth.uid)).data);
    }

    function membershipIsActive(membership) {
      return (
          ("status" in membership && membership.status == "active")
          || (!("status" in membership) && membership.active == true)
        )
        && (!("leftAt" in membership) || membership.leftAt == null);
    }

    function memberData(classId) {
      return get(memberPath(classId, request.auth.uid)).data;
    }

    function memberRole(classId) {
      return memberData(classId).role;
    }

    function isClassStudent(classId) {
      return isClassMember(classId) && memberRole(classId) == "student";
    }

    function isClassTeacher(classId) {
      return isClassMember(classId) && memberRole(classId) == "teacher";
    }

    function isClassVolunteer(classId) {
      return isClassMember(classId) && memberRole(classId) == "volunteer";
    }

    function isOwnerStudent(studentUid) {
      return hasAccountAccess(studentUid);
    }

    function isActiveStudentMember(classId, studentUid) {
      return classIsOperational(classId)
        && exists(memberPath(classId, studentUid))
        && membershipIsActive(get(memberPath(classId, studentUid)).data)
        && get(memberPath(classId, studentUid)).data.role == "student";
    }

    function isActiveVolunteerMember(classId, volunteerUid) {
      return classIsOperational(classId)
        && exists(memberPath(classId, volunteerUid))
        && membershipIsActive(get(memberPath(classId, volunteerUid)).data)
        && get(memberPath(classId, volunteerUid)).data.role == "volunteer";
    }

    function isStudentMembershipRecord(classId, studentUid) {
      return exists(memberPath(classId, studentUid))
        && get(memberPath(classId, studentUid)).data.role == "student";
    }

    function studentVisibilityStartsAt(classId, studentUid) {
      let membership = get(memberPath(classId, studentUid)).data;
      return "visibilityStartsAt" in membership
        ? membership.visibilityStartsAt
        : membership.joinedAt;
    }

    function isInsideStudentMembershipWindow(classId, studentUid, createdAt) {
      let membership = get(memberPath(classId, studentUid)).data;
      return isStudentMembershipRecord(classId, studentUid)
        && createdAt is timestamp
        && createdAt >= studentVisibilityStartsAt(classId, studentUid)
        && (
          membershipIsActive(membership)
          || (
            "leftAt" in membership
            && membership.leftAt is timestamp
            && createdAt <= membership.leftAt
          )
        );
    }

    function staffCanReadStudentTimeline(classId, studentUid, createdAt) {
      return isInsideStudentMembershipWindow(classId, studentUid, createdAt)
        && isClassTeacher(classId);
    }

    function staffCanWriteStudentTimeline(classId, studentUid, createdAt) {
      return isActiveStudentMember(classId, studentUid)
        && createdAt is timestamp
        && createdAt >= studentVisibilityStartsAt(classId, studentUid)
        && isClassTeacher(classId);
    }

    function classStaffCanReadSupportTimeline(classId, studentUid, createdAt) {
      return isInsideStudentMembershipWindow(classId, studentUid, createdAt)
        && (
          isClassTeacher(classId)
          || isClassVolunteer(classId)
        );
    }

    function classStaffCanWriteSupportTimeline(classId, studentUid, createdAt) {
      return isActiveStudentMember(classId, studentUid)
        && createdAt is timestamp
        && createdAt >= studentVisibilityStartsAt(classId, studentUid)
        && (isClassTeacher(classId) || isClassVolunteer(classId));
    }

    function validActiveClassSelection(uid) {
      return !("activeClassId" in request.resource.data)
        || request.resource.data.activeClassId == null
        || (
          request.resource.data.activeClassId is string
          && classIsOperational(request.resource.data.activeClassId)
          && exists(memberPath(request.resource.data.activeClassId, uid))
          && membershipIsActive(
            get(memberPath(request.resource.data.activeClassId, uid)).data
          )
        );
    }

    function threadPath(classId, threadId) {
      return /databases/$(database)/documents/classes/$(classId)/supportThreads/$(threadId);
    }

    function canReadStudentRecord(classId, studentUid) {
      return (isOwnerStudent(studentUid) && isClassStudent(classId))
        || (
          isStudentMembershipRecord(classId, studentUid)
          && isClassTeacher(classId)
        );
    }

    function canReadSupportThread(classId, thread) {
      return classStaffCanReadSupportTimeline(
          classId,
          thread.studentUid,
          thread.createdAt
        )
        || (
          isSelf(thread.studentUid)
          && isClassStudent(classId)
          && thread.studentVisible == true
        )
        ;
    }

    function canReadThread(classId, threadId) {
      return canReadSupportThread(
        classId,
        get(threadPath(classId, threadId)).data
      );
    }

    function canWriteStaffReply(classId, threadId) {
      let thread = get(threadPath(classId, threadId)).data;
      return classStaffCanWriteSupportTimeline(
        classId,
        thread.studentUid,
        thread.createdAt
      )
        && thread.status != "closed"
        && thread.status != "archived"
        && (!("withdrawnAt" in thread) || thread.withdrawnAt == null);
    }

    function validMasteryProjection(data, studentUid, masteryId) {
      return data.keys().hasOnly([
          "masteryId",
          "studentUid",
          "curriculumKey",
          "unit",
          "skill",
          "questionType",
          "level",
          "attemptCount",
          "correctCount",
          "firstTryCorrectCount",
          "consecutiveCorrectCount",
          "masteryScore",
          "lastQuestionId",
          "lastResultCorrect",
          "lastAttemptSource",
          "lastAnsweredAt",
          "nextReviewAt",
          "updatedAt"
        ])
        && data.masteryId == masteryId
        && data.studentUid == studentUid
        && data.curriculumKey is string
        && data.curriculumKey.size() > 0
        && data.unit is string
        && data.skill is string
        && data.questionType in [
          "vocabulary",
          "grammar",
          "fillBlank",
          "cloze",
          "reading",
          "translation",
          "dialogue"
        ]
        && data.level in ["A1", "A2", "B1", "B2"]
        && data.attemptCount is int
        && data.attemptCount > 0
        && data.attemptCount <= 100000
        && data.correctCount is int
        && data.correctCount >= 0
        && data.correctCount <= data.attemptCount
        && data.firstTryCorrectCount is int
        && data.firstTryCorrectCount >= 0
        && data.firstTryCorrectCount <= data.correctCount
        && data.consecutiveCorrectCount is int
        && data.consecutiveCorrectCount >= 0
        && data.consecutiveCorrectCount <= data.correctCount
        && data.masteryScore is int
        && data.masteryScore >= 0
        && data.masteryScore <= 100
        && data.lastQuestionId is string
        && data.lastQuestionId.size() > 0
        && data.lastResultCorrect is bool
        && data.lastAttemptSource in [
          "dailyMission",
          "freePractice",
          "repairPractice",
          "teacherAssignment"
        ]
        && data.lastAnsweredAt is timestamp
        && data.nextReviewAt is timestamp
        && data.nextReviewAt >= data.lastAnsweredAt
        && data.updatedAt is timestamp
        && data.updatedAt == data.lastAnsweredAt;
    }

    function validMasteryUpdate(studentUid, masteryId) {
      return validMasteryProjection(request.resource.data, studentUid, masteryId)
        && request.resource.data.masteryId == resource.data.masteryId
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.curriculumKey == resource.data.curriculumKey
        && request.resource.data.unit == resource.data.unit
        && request.resource.data.skill == resource.data.skill
        && request.resource.data.questionType == resource.data.questionType
        && request.resource.data.level == resource.data.level
        && request.resource.data.attemptCount > resource.data.attemptCount
        && request.resource.data.correctCount >= resource.data.correctCount
        && request.resource.data.firstTryCorrectCount >= resource.data.firstTryCorrectCount
        && request.resource.data.updatedAt > resource.data.updatedAt;
    }

    match /appConfig/{docId} {
      allow read: if hasAccountAccess(request.auth.uid);
      allow write: if false;
    }

    match /staffInvitations/{invitationId} {
      allow read, write: if false;
    }

    match /volunteerJoinCodes/{code} {
      allow read, write: if false;
    }

    match /educationInstitutions/{institutionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /teacherProfiles/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && isTeacherProfileAfter(uid)
        && request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "institutionId",
          "institutionName",
          "institutionKind",
          "institutionSource",
          "claimStatus",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.institutionId is string
        && request.resource.data.institutionName is string
        && request.resource.data.institutionKind is string
        && request.resource.data.institutionSource in [
          "ministryOfEducation",
          "userSubmitted"
        ]
        && request.resource.data.claimStatus == "selfDeclared";
      allow update: if hasAccountAccess(uid)
        && resource.data.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.claimStatus == "selfDeclared"
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "institutionId",
          "institutionName",
          "institutionKind",
          "institutionSource",
          "updatedAt"
        ]);
      allow delete: if false;
    }

    match /volunteerApplications/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && isPendingVolunteerAfter(uid)
        && request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "status",
          "confirmsAge18OrOlder",
          "acceptedConductVersion",
          "motivation",
          "evidence",
          "submittedAt",
          "updatedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.status in ["draft", "pendingReview"]
        && request.resource.data.confirmsAge18OrOlder == true
        && request.resource.data.acceptedConductVersion is string
        && request.resource.data.motivation is string
        && request.resource.data.evidence is list
        && (
          (
            request.resource.data.status == "draft"
            && request.resource.data.evidence.size() == 0
          )
          || (
            request.resource.data.status == "pendingReview"
            && request.resource.data.evidence.size() > 0
          )
        );
      allow update: if isSelf(uid)
        && resource.data.status in ["draft", "needsMoreInformation", "rejected"]
        && request.resource.data.status == "pendingReview"
        && getAfter(userPath(uid)).data.accountStatus == "pendingApproval"
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "motivation",
          "evidence",
          "submittedAt",
          "updatedAt"
        ]);
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          "displayName",
          "preferredName",
          "primaryRole",
          "activeClassId",
          "createdAt",
          "updatedAt",
          "lastLoginAt",
          "active",
          "accountStatus",
          "emailVerificationRequired",
          "provisioningSource",
          "identityProviders"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.preferredName is string
        && request.resource.data.activeClassId == null
        && request.resource.data.identityProviders is list
        && request.resource.data.identityProviders.size() > 0
        && validInitialEmailPolicy(request.resource.data)
        && validSelfServiceProfile(request.resource.data);
      allow update: if (
          hasAccountAccess(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName",
            "preferredName",
            "lastLoginAt",
            "updatedAt",
            "activeClassId"
          ])
          && request.resource.data.primaryRole == resource.data.primaryRole
          && validActiveClassSelection(uid)
        ) || (
          isSelf(uid)
          && validVolunteerSubmission(uid)
        ) || (
          validIdentityProviderUpdate(uid)
        );
      allow delete: if false;

      match /classMemberships/{classId} {
        allow read: if isSelf(uid);
        allow create, update, delete: if false;
      }

      match /volunteerServices/{classId} {
        allow read: if isSelf(uid);
        allow create, update, delete: if false;
      }

      match /settings/{settingId} {
        allow read, create, update, delete: if hasAccountAccess(uid);
      }

      match /personalCheckIns/{dateKey} {
        allow read, create, update: if hasAccountAccess(uid);
        allow delete: if false;
      }

      match /personalDailyMissions/{missionId} {
        allow read, create, update: if hasAccountAccess(uid);
        allow delete: if false;
      }

      match /personalAnswerEvents/{eventId} {
        allow read, create: if hasAccountAccess(uid);
        allow update, delete: if false;
      }

      match /personalLearningEvents/{eventId} {
        allow read, create: if hasAccountAccess(uid);
        allow update, delete: if false;
      }

      match /skillMastery/{masteryId} {
        allow read: if hasAccountAccess(uid);
        allow create: if hasAccountAccess(uid)
          && validMasteryProjection(request.resource.data, uid, masteryId);
        allow update: if hasAccountAccess(uid)
          && validMasteryUpdate(uid, masteryId);
        allow delete: if false;
      }

      match /consents/{consentVersion} {
        allow read: if hasAccountAccess(uid);
        allow create: if hasAccountAccess(uid)
          && request.resource.data.acceptedByUid == request.auth.uid
          && request.resource.data.accepted == true;
        allow update, delete: if false;
      }
    }

    match /classes/{classId} {
      allow read: if isClassMember(classId);
      allow write: if false;

      match /members/{uid} {
        allow read: if isSelf(uid) || isClassTeacher(classId);
        allow create, update, delete: if false;
      }

      match /volunteerRequests/{uid} {
        allow read: if isSelf(uid) || isClassTeacher(classId);
        allow create, update, delete: if false;
      }

      match /students/{studentUid} {
        allow get: if canReadStudentRecord(classId, studentUid);
        allow list: if isClassTeacher(classId)
          && resource.data.membershipStatus == "active";
        allow create: if isOwnerStudent(studentUid)
          && isClassStudent(classId)
          && request.resource.data.uid == studentUid
          && request.resource.data.classCode == classId
          && request.resource.data.membershipStatus == "active";
        allow update: if isOwnerStudent(studentUid)
          && isClassStudent(classId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.classCode == resource.data.classCode
          && request.resource.data.membershipStatus == "active"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName",
            "currentLevel",
            "recommendedTrack",
            "lastMoodScore",
            "lastMissionStatus",
            "lastActivityAt",
            "riskLevel",
            "membershipStatus",
            "updatedAt"
          ]);
        allow delete: if false;

        match /checkIns/{dateKey} {
          allow read: if (isOwnerStudent(studentUid) && isClassStudent(classId))
            || staffCanReadStudentTimeline(classId, studentUid, resource.data.createdAt);
          allow create: if isOwnerStudent(studentUid) && isClassStudent(classId);
          allow update: if (isOwnerStudent(studentUid) && isClassStudent(classId))
            || staffCanWriteStudentTimeline(classId, studentUid, resource.data.createdAt);
          allow delete: if false;
        }

        match /consents/{consentVersion} {
          allow read: if (isOwnerStudent(studentUid) && isClassStudent(classId))
            || staffCanReadStudentTimeline(classId, studentUid, resource.data.acceptedAt);
          allow create: if isOwnerStudent(studentUid)
            && isClassStudent(classId)
            && request.resource.data.acceptedByUid == request.auth.uid
            && request.resource.data.accepted == true;
          allow update, delete: if false;
        }

        match /deletionRequests/{requestId} {
          allow read: if (isOwnerStudent(studentUid) && isClassStudent(classId))
            || (isClassTeacher(classId) && isActiveStudentMember(classId, studentUid));
          allow create: if isOwnerStudent(studentUid)
            && isClassStudent(classId)
            && request.resource.data.requestedByUid == request.auth.uid
            && request.resource.data.studentUid == studentUid
            && request.resource.data.status == "requested";
          allow update: if isClassTeacher(classId);
          allow delete: if false;
        }

        match /dailyMissions/{missionId} {
          allow read: if (isOwnerStudent(studentUid) && isClassStudent(classId))
            || staffCanReadStudentTimeline(classId, studentUid, resource.data.createdAt);
          allow create: if isOwnerStudent(studentUid)
            && isClassStudent(classId)
            && request.resource.data.studentUid == studentUid
            && request.resource.data.missionId == missionId
            && request.resource.data.questionIds is list
            && request.resource.data.questionIds.size() > 0
            && request.resource.data.questionIds.size() <= 20
            && request.resource.data.createdAt is timestamp;
          allow update: if isOwnerStudent(studentUid)
            && isClassStudent(classId)
            && request.resource.data.studentUid == resource.data.studentUid
            && request.resource.data.missionId == resource.data.missionId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "correctCount",
              "progressPercent",
              "completedAt"
            ]);
          allow delete: if false;
        }

        match /answerEvents/{eventId} {
          allow read: if (isOwnerStudent(studentUid) && isClassStudent(classId))
            || staffCanReadStudentTimeline(classId, studentUid, resource.data.createdAt);
          allow create: if isOwnerStudent(studentUid) && isClassStudent(classId);
          allow update, delete: if false;
        }

        match /learningEvents/{eventId} {
          allow read: if (isOwnerStudent(studentUid) && isClassStudent(classId))
            || staffCanReadStudentTimeline(classId, studentUid, resource.data.createdAt);
          allow create: if isOwnerStudent(studentUid) && isClassStudent(classId);
          allow update, delete: if false;
        }

        match /skillMastery/{masteryId} {
          allow read: if (isOwnerStudent(studentUid) && isClassStudent(classId))
            || staffCanReadStudentTimeline(classId, studentUid, resource.data.lastAnsweredAt);
          allow create: if isOwnerStudent(studentUid)
            && isClassStudent(classId)
            && validMasteryProjection(request.resource.data, studentUid, masteryId);
          allow update: if isOwnerStudent(studentUid)
            && isClassStudent(classId)
            && validMasteryUpdate(studentUid, masteryId);
          allow delete: if false;
        }
      }

      match /supportThreads/{threadId} {
        allow get: if canReadSupportThread(classId, resource.data);
        allow list: if isClassTeacher(classId)
          || isClassVolunteer(classId)
          || (
            isClassStudent(classId)
            && resource.data.studentUid == request.auth.uid
            && resource.data.studentVisible == true
          );

        allow create: if isClassStudent(classId)
          && request.resource.data.studentUid == request.auth.uid
          && request.resource.data.classId == classId
          && request.resource.data.studentVisible == true
          && request.resource.data.threadId == threadId
          && request.resource.data.createdAt is timestamp;

        allow update: if (
            canWriteStaffReply(classId, threadId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "latestMessagePreview",
              "staffArchivedAt",
              "teacherArchivedAt",
              "volunteerArchivedAt",
              "handledWithoutReplyAt",
              "teacherHandledWithoutReplyAt",
              "volunteerHandledWithoutReplyAt",
              "handledByUid",
              "handledByName",
              "handledByRole",
              "updatedAt"
            ])
          )
          || (
            isSelf(resource.data.studentUid)
            && isClassStudent(classId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "studentArchivedAt",
              "withdrawnAt",
              "studentLastReadAt",
              "updatedAt"
            ])
          );

        allow delete: if false;

        match /messages/{messageId} {
          allow read: if canReadThread(classId, threadId)
            && (
              resource.data.visibility == "studentVisible"
              || canWriteStaffReply(classId, threadId)
            );

          allow create: if (
              isSelf(getAfter(threadPath(classId, threadId)).data.studentUid)
              && isClassStudent(classId)
              && request.resource.data.authorUid == request.auth.uid
              && request.resource.data.authorRole == "student"
              && request.resource.data.visibility == "studentVisible"
              && request.resource.data.messageType == "studentRequest"
              && request.resource.data.body is string
              && request.resource.data.createdAt is timestamp
            )
            || (
              canWriteStaffReply(classId, threadId)
              && request.resource.data.authorUid == request.auth.uid
              && request.resource.data.authorRole == memberRole(classId)
              && (
                (
                  request.resource.data.authorRole == "teacher"
                  && request.resource.data.messageType == "teacherReply"
                )
                || (
                  request.resource.data.authorRole == "volunteer"
                  && request.resource.data.messageType == "volunteerReply"
                )
              )
              && request.resource.data.visibility in ["studentVisible", "staffOnly"]
              && request.resource.data.body is string
              && request.resource.data.createdAt is timestamp
            );

          allow update, delete: if false;
        }
      }

      match /staffAssignments/{assignmentId} {
        allow read: if isClassTeacher(classId)
          || (isClassVolunteer(classId) && resource.data.assignedToUid == request.auth.uid)
          || (isSelf(resource.data.studentUid) && isClassStudent(classId));

        allow create: if isClassTeacher(classId)
          && request.resource.data.classId == classId
          && request.resource.data.assignedToUid is string
          && request.resource.data.studentUid is string
          && isActiveVolunteerMember(classId, request.resource.data.assignedToUid)
          && isActiveStudentMember(classId, request.resource.data.studentUid);
        allow update: if isClassTeacher(classId)
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.assignedToUid == resource.data.assignedToUid
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "nextAction",
            "updatedAt"
          ]);
        allow delete: if false;
      }

      match /practiceAssignments/{assignmentId} {
        allow get: if (isSelf(resource.data.studentUid) && isClassStudent(classId))
          || staffCanReadStudentTimeline(
            classId,
            resource.data.studentUid,
            resource.data.createdAt
          );
        allow list: if isClassTeacher(classId)
          || (
            isClassStudent(classId)
            && resource.data.studentUid == request.auth.uid
          );
        allow create: if isClassTeacher(classId)
          && isActiveStudentMember(classId, request.resource.data.studentUid)
          && request.resource.data.assignmentId == assignmentId
          && request.resource.data.classId == classId
          && request.resource.data.assignedByUid == request.auth.uid
          && request.resource.data.status == "pending"
          && request.resource.data.questionIds is list
          && request.resource.data.questionIds.size() > 0
          && request.resource.data.questionIds.size() <= 12
          && request.resource.data.createdAt is timestamp;
        allow update: if (
            isClassTeacher(classId)
            && request.resource.data.studentUid == resource.data.studentUid
            && request.resource.data.classId == resource.data.classId
            && request.resource.data.assignmentId == resource.data.assignmentId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status == "withdrawn"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "updatedAt"
            ])
          )
          || (
            isSelf(resource.data.studentUid)
            && isClassStudent(classId)
            && resource.data.status in ["pending", "active"]
            && request.resource.data.status in ["active", "completed"]
            && request.resource.data.questionResults is list
            && request.resource.data.questionResults.size()
              <= resource.data.questionIds.size()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "questionResults",
              "updatedAt"
            ])
          );
        allow delete: if false;
      }

      match /questionBank/{questionId} {
        allow read: if isClassMember(classId)
          && (resource.data.reviewState == "approved" || isClassTeacher(classId));
        allow create, update: if isClassTeacher(classId);
        allow delete: if false;
      }

      match /reports/{reportId} {
        allow read, create, update: if isClassTeacher(classId);
        allow delete: if false;
      }

      match /aiUsage/{usageId} {
        allow read: if isClassTeacher(classId) || isSelf(resource.data.uid);
        allow write: if false;
      }

      match /aiEvents/{eventId} {
        allow read: if isClassTeacher(classId) || isSelf(resource.data.uid);
        allow write: if false;
      }

      match /privacyAuditLogs/{eventId} {
        allow read: if isClassTeacher(classId);
        allow write: if false;
      }

      match /syncQueue/{syncItemId} {
        allow read, create, update: if isClassTeacher(classId);
        allow delete: if false;
      }
    }

    // Join-code lookup and owner-only code rotation are trusted-backend
    // operations. Keeping these collections unreadable prevents students from
    // enumerating valid class codes even after they join a class.
    match /classAdmins/{classId} {
      allow read, write: if false;
    }

    match /classJoinCodes/{joinCode} {
      allow read, write: if false;
    }

    match /classJoinAttempts/{uid} {
      allow read, write: if false;
    }

    // Account deletion is a trusted-backend workflow. Jobs may temporarily
    // contain a UID only while cleanup is retryable; anonymous metrics contain
    // no user identifier. Neither collection is client-readable or writable.
    match /accountDeletionJobs/{uid} {
      allow read, write: if false;
    }

    match /anonymousProductMetrics/{metricId} {
      allow read, write: if false;
    }
  }
}
